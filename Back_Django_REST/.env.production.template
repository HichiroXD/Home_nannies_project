# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - Home Nannies
# ==============================================================================
# Este archivo documenta las variables de entorno necesarias para producción

# CRÍTICO: Configuración Base
SECRET_KEY=<generar_con_django_generate_secret_key>
DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com,.railway.app

# Base de Datos (PostgreSQL recomendado para producción)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS (Especificar dominios exactos)
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME=15  # minutos
JWT_REFRESH_TOKEN_LIFETIME=7  # días

# Email (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password

# Almacenamiento de Archivos (AWS S3, Cloudinary, etc)
# AWS_ACCESS_KEY_ID=<tu_key>
# AWS_SECRET_ACCESS_KEY=<tu_secret>
# AWS_STORAGE_BUCKET_NAME=<tu_bucket>
# AWS_S3_REGION_NAME=us-east-1

# Servicios Externos
# SENTRY_DSN=<tu_sentry_dsn>  # Monitoreo de errores
# REDIS_URL=<tu_redis_url>  # Cache y Celery

# ==============================================================================
# CHECKLIST DE DEPLOY
# ==============================================================================

# Antes de Deploy:
# □ Generar SECRET_KEY única (python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# □ Configurar ALLOWED_HOSTS con dominios reales
# □ Configurar DATABASE_URL (PostgreSQL)
# □ Configurar CORS_ALLOWED_ORIGINS
# □ Configurar certificado SSL/HTTPS
# □ Ejecutar python manage.py check --deploy
# □ Ejecutar collectstatic
# □ Configurar backup automático de DB
# □ Configurar monitoreo (Sentry, etc)

# Railway Deploy:
# 1. railway login
# 2. railway init
# 3. railway add
# 4. Configurar variables en Railway Dashboard
# 5. railway up

# Gunicorn (Production Server):
# gunicorn django_crud_api.wsgi:application --bind 0.0.0.0:8000 --workers 4

# ==============================================================================
# COMANDOS ÚTILES
# ==============================================================================

# Generar SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Check de seguridad:
# python manage.py check --deploy

# Migraciones:
# python manage.py makemigrations
# python manage.py migrate

# Recolectar archivos estáticos:
# python manage.py collectstatic --noinput

# Crear superuser:
# python manage.py createsuperuser

# Backup de base de datos:
# python manage.py dumpdata > backup.json

# ==============================================================================
# MONITOREO Y MANTENIMIENTO
# ==============================================================================

# Logs:
# - Ubicación: /logs/*.log
# - Rotación: Configurar logrotate
# - Alertas: Configurar para errores críticos

# Backups:
# - Frecuencia: Diario (automático)
# - Retención: 30 días
# - Storage: S3 o similar

# Updates:
# - Dependencies: Mensual (pip-audit)
# - Django: Seguir LTS releases
# - Security patches: Inmediato

