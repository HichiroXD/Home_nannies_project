# ============================================
# CONFIGURACIÓN PARA SERVIDOR DEBIAN/PRODUCCIÓN
# ============================================

# Modo Debug - SIEMPRE False en producción
DEBUG=False

# Clave secreta - CAMBIAR por una única y segura
# Puedes generarla con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIAR-POR-UNA-CLAVE-SECRETA-UNICA

# Hosts permitidos - Agrega tu IP/dominio del servidor
ALLOWED_HOSTS=localhost,127.0.0.1,104.248.213.225,tudominio.com

# ============================================
# CONFIGURACIÓN CORS
# ============================================

# Orígenes permitidos para CORS - IP + Puerto donde corre el Frontend
CORS_ALLOWED_ORIGINS=http://104.248.213.225:5173,http://104.248.213.225:5174,https://tudominio.com

# CSRF Trusted Origins - Agrega los mismos orígenes
CSRF_TRUSTED_ORIGINS=http://104.248.213.225:5173,http://104.248.213.225:8000,http://104.248.213.225,https://tudominio.com

# ============================================
# BASE DE DATOS (PostgreSQL en Producción)
# ============================================

# Descomentar si usas PostgreSQL en producción
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_database

# Si usas SQLite (solo desarrollo/testing)
# DATABASE_URL se puede omitir

