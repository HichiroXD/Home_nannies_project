# ============================================
# CONFIGURACIÓN DE DJANGO - HOME NANNIES
# ============================================
# IMPORTANTE: Este archivo es un template.
# Copia este archivo a .env y configura tus valores reales.
# NUNCA subas el archivo .env al repositorio.

# ============================================
# SEGURIDAD (CRÍTICO)
# ============================================
# Genera una SECRET_KEY segura con: python generate_secret_key.py
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_IN_PRODUCTION

# DEBUG: Siempre False en producción
DEBUG=True

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,104.248.213.225

# ============================================
# BASE DE DATOS
# ============================================
# PostgreSQL (Producción)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# PostgreSQL Local (Desarrollo)
USE_POSTGRESQL=False
DB_NAME=home_nannies_dev
DB_USER=home_nannies_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CORS Y CSRF (Frontend)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL (Opcional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
