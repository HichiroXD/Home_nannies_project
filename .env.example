# ========================================
# Variables de Entorno - Home Nannies
# ========================================
# Copia este archivo a .env y rellena los valores
# NUNCA commitear el archivo .env real

# ========================================
# SEGURIDAD
# ========================================
# Genera una nueva SECRET_KEY con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-super-segura-aqui

# DEBUG: True para desarrollo, False para producción
DEBUG=False

# ========================================
# HOSTS Y DOMINIOS
# ========================================
# Hosts permitidos (separados por comas, sin espacios)
# Ejemplo: .railway.app,api.tudominio.com,tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (URLs completas con https://)
# Ejemplo: https://tu-backend.up.railway.app,https://api.tudominio.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# CORS Allowed Origins (URLs del frontend)
# Ejemplo: https://tu-frontend.vercel.app,https://tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================
# BASE DE DATOS
# ========================================
# Railway provee esta variable automáticamente con el plugin PostgreSQL
# Para desarrollo local con PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# Para SQLite (desarrollo local), dejar en blanco o comentar
# DATABASE_URL=

# ========================================
# FRONTEND
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# AWS S3 (Opcional - para archivos media)
# ========================================
# AWS_ACCESS_KEY_ID=tu-access-key-id
# AWS_SECRET_ACCESS_KEY=tu-secret-access-key
# AWS_STORAGE_BUCKET_NAME=nombre-de-tu-bucket
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=tu-bucket.s3.amazonaws.com

# ========================================
# CLOUDINARY (Alternativa a S3)
# ========================================
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# ========================================
# EMAIL (SMTP)
# ========================================
# Para desarrollo, Django usa console backend
# Para producción, configurar SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-password-de-aplicacion

# ========================================
# SENTRY (Monitoreo de errores)
# ========================================
# SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# ========================================
# REDIS (Cache y Celery)
# ========================================
# REDIS_URL=redis://localhost:6379/0

# ========================================
# CELERY (Tareas asíncronas)
# ========================================
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# DESARROLLO
# ========================================
# Configuraciones adicionales para desarrollo local
# DJANGO_SETTINGS_MODULE=django_crud_api.settings
